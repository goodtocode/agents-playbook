<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
    <RootNamespace>Goodtocode.Agents.Playbook</RootNamespace>
    <AssemblyName>Goodtocode.Agents.Playbook</AssemblyName>
		<Version>2.0.0</Version>
		<FileVersion>2.0.0</FileVersion>
		<AssemblyVersion>2.0.0</AssemblyVersion>
		<InformationalVersion>2.0.0</InformationalVersion>
    <TargetFrameworks>net10.0</TargetFrameworks>		
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

    <IsPackable>true</IsPackable>
		<PackageId>Goodtocode.Agents.Playbook</PackageId>
		<Authors>Robert Good</Authors>
		<Company>Goodtocode</Company>
    <Description>AI governance primitives and application enforcement for observability, auditability, repeatability, and defensibility.</Description>
    <PackageTags>ai;governance;observability;auditability;repeatability;defensibility</PackageTags>
		<RepositoryUrl>https://github.com/Goodtocode/agents-playbook</RepositoryUrl>
		<PackageProjectUrl>https://github.com/Goodtocode/agents-playbook</PackageProjectUrl>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<Copyright>Copyright © 2026 Goodtocode</Copyright>
		<PackageIcon>Goodtocode-icon.png</PackageIcon>
		<PackageReadmeFile>README.md</PackageReadmeFile>
	</PropertyGroup>

	<ItemGroup>
		<None Include="Goodtocode-icon.png" Pack="true" PackagePath="" />
		<None Include="..\..\README.md" Pack="true" PackagePath="" />
	</ItemGroup>

</Project>
