<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<RootNamespace>Goodtocode.Agents.Playbook.Prompting</RootNamespace>
		<AssemblyName>Goodtocode.Agents.Playbook.Prompting</AssemblyName>
		<Version>1.0.0</Version>
		<FileVersion>1.0.0</FileVersion>
		<AssemblyVersion>1.0.0</AssemblyVersion>
		<InformationalVersion>1.0.0</InformationalVersion>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<IsPackable>true</IsPackable>
		<PackageId>Goodtocode.Agents.Playbook.Prompting</PackageId>
		<Authors>Robert Good</Authors>
		<Company>Goodtocode</Company>
		<Description>Universal, prompt-based Collect/Evaluate/Record tools for Goodtocode.Agents.Playbook, backed by Microsoft.Extensions.AI.</Description>
		<PackageTags>ai;playbook;workflow;collect;evaluate;record;prompt;llm</PackageTags>
		<RepositoryUrl>https://github.com/Goodtocode/agents-playbook</RepositoryUrl>
		<PackageProjectUrl>https://github.com/Goodtocode/agents-playbook</PackageProjectUrl>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<Copyright>Copyright © 2026 Goodtocode</Copyright>
		<PackageIcon>Goodtocode-icon.png</PackageIcon>
		<PackageReadmeFile>README.md</PackageReadmeFile>
	</PropertyGroup>

	<ItemGroup>
		<None Include="..\Goodtocode.Agents.Playbook\Goodtocode-icon.png" Pack="true" PackagePath="" />
		<None Include="README.md" Pack="true" PackagePath="" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.AI" Version="10.10.0" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Goodtocode.Agents.Playbook\Goodtocode.Agents.Playbook.csproj" />
	</ItemGroup>

</Project>
